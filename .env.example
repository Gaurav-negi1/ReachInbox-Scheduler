# ===== Backend (server + worker read these) =====
NODE_ENV=development
PORT=4000

# Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
# Optional API key for secured clusters; leave blank for local no-auth setup
ELASTICSEARCH_API_KEY=

# Bull Board live queue dashboard (HTTP basic auth)
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=admin123

# Google OAuth (console.cloud.google.com -> OAuth client, Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
# Comma-separated list, no spaces
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# 32+ random chars
SESSION_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:5173

# Slack OAuth (api.slack.com/apps -> OAuth & Permissions redirect URL http://localhost:4000/api/slack/callback)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback

# ===== Email send worker =====
# Worker concurrency (parallel jobs)
WORKER_CONCURRENCY=5
# Minimum seconds between any two SMTP sends
MIN_SEND_DELAY_SECONDS=2
# Global hourly cap across all senders (0 = unlimited)
MAX_EMAILS_PER_HOUR=200
# Per-sender hourly cap (0 = unlimited)
MAX_EMAILS_PER_HOUR_PER_SENDER=0
# BullMQ job retention / behavior
MAX_ATTEMPTS=5
BACKOFF_MS=5000
# Remove completed/failed jobs from Bull after this many ms (DB remains source of truth)
JOB_RETENTION_MS=3600000
# Optional: route sends to a local SMTP sink instead of Ethereal (off by default)
USE_FAKE_SMTP_SINK=false
